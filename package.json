{
  "name": "geesling",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/pixelify-sans": "^0.4.2",
    "@expo-google-fonts/vt323": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ingest",
    "ingest": "node --max-old-space-size=4096 ingest/run.ts",
    "ingest:dry": "node --max-old-space-size=4096 ingest/run.ts --dry-run",
    "export:web": "expo export -p web",
    "lint": "expo lint",
    "deploy:web": "expo export -p web && npx eas-cli@latest deploy --prod",
    "usage": "supabase db query --linked -o json -f scripts/usage-report.sql"
  },
  "private": true
}
