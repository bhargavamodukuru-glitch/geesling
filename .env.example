# --- App (public, bundled into the client) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Google Maps JavaScript API key (web). Restrict it to your web domains.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Cloud Map ID styled with src/components/map/mapStyle.ts (defaults to DEMO_MAP_ID)
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Public web URL used in share links, e.g. https://geesling.expo.app
EXPO_PUBLIC_SITE_URL=

# --- Native builds (read by app.config.ts) ---
GOOGLE_MAPS_ANDROID_API_KEY=
# Leave empty to use Apple Maps on iOS
GOOGLE_MAPS_IOS_API_KEY=

# --- Ingestion (GitHub Actions secrets / local `npm run ingest`) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=

# --- Edge function secrets (`supabase secrets set ...`) ---
# ANTHROPIC_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=   (Places API (New) + Routes API enabled)
